# Copy to .env. Used by docker compose and by `pnpm dev`.

# Required. Use letters and digits only, since it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# One-time secret that protects initial setup (creating the first administrator).
# At least 32 characters. Set it before first launch, use it once at /setup, then remove
# it: setup stays closed forever, with or without this value.
# BOOTSTRAP_SECRET=generate-a-long-random-secret-of-at-least-32-characters

# The key that encrypts instance secrets at rest (ADR-0004): base64 for exactly 32
# bytes. Generate with: openssl rand -base64 32
# Without it, an SMTP password cannot be saved (the settings say which to set).
# ORRERY_ENCRYPTION_KEY=openssl-rand-base64-32-output

# Outgoing webhooks are delivered only to https:// public addresses by default. Set this
# to true only to send them to an internal LAN receiver (this also permits http://).
# ORRERY_WEBHOOK_ALLOW_PRIVATE_URLS=false

# Object storage (ADR-0008). The default `local` driver needs no extra containers and
# keeps blobs under ORRERY_DATA_DIR/objects, mounted as the `orrery-data` volume by
# docker compose. A plain `docker compose up -d` therefore runs only Orrery + Postgres.
# ORRERY_STORAGE_DRIVER=local
# ORRERY_DATA_DIR=/app/data

# S3-compatible storage. Set ORRERY_STORAGE_DRIVER=s3 and fill in the four required
# values below (endpoint, bucket, access key id, secret access key); the server fails
# fast at startup if any is missing or the bucket is unreachable. ORRERY_S3_REGION
# defaults to us-east-1 and ORRERY_S3_FORCE_PATH_STYLE to false.
# `--profile storage` runs RustFS with the credentials below; create the bucket once
# in its console at http://localhost:9001 (see docs/guides/install.md). Use
# http://localhost:9000 for `pnpm dev` and http://rustfs:9000 inside compose.
# ORRERY_S3_ENDPOINT=http://rustfs:9000
# ORRERY_S3_BUCKET=orrery
# ORRERY_S3_REGION=us-east-1
# ORRERY_S3_ACCESS_KEY_ID=orreryaccesskey
# ORRERY_S3_SECRET_ACCESS_KEY=orrerysecretkey
# Path-style addressing: needed by RustFS/MinIO/Garage, usually false for AWS S3.
# ORRERY_S3_FORCE_PATH_STYLE=true

# Host-side ports for the optional `--profile storage` RustFS service (API + console).
# RUSTFS_PORT=9000
# RUSTFS_CONSOLE_PORT=9001

# The URL people and agents use to reach Orrery. MCP only accepts requests for this host.
PUBLIC_URL=http://localhost:8080

# HTTPS (docker compose --profile tls): your domain, and PUBLIC_URL=https://<that domain>.
# ORRERY_DOMAIN=orrery.example.com

# Pin an image version instead of latest.
# ORRERY_VERSION=0.1.0

# The Mailpit test catcher's web UI and API. Only `docker compose --profile mail-test`
# starts it; these host-side ports exist for that flow.
# MAILPIT_HTTP_PORT=8025

# For `pnpm dev`: the server on your machine talks to the compose Postgres.
DATABASE_URL=postgres://orrery:change-me@localhost:5432/orrery
