# --- Dependencies and builds ---
node_modules/
dist/
coverage/
.vitest/
test-results/
playwright-report/
# Written by every e2e run; the log check reads it afterwards.
tests/e2e/.secrets-used
*.tsbuildinfo
.vite/
npm-debug.log*
pnpm-debug.log*

# --- Local config and secrets ---
.env
.env.*
!.env.example

# Local runner stream spools must never show up as untracked files in a worktree.
.orrery/runs/

# --- Local Docker data (docker compose volumes bound to the repo) ---
/data/

# Local Runner object-store data written by server tests; never ship it.
apps/server/data/

# --- Editors and OS ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# --- Claude Code (personal settings only; shared settings stay committed) ---
.claude/settings.local.json
