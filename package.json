{
  "name": "orrery",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "astryx": "pnpm --filter @orrery/web run astryx",
    "dev": "pnpm --parallel --filter @orrery/server --filter @orrery/web dev",
    "build": "pnpm --filter @orrery/web build",
    "gen": "pnpm --filter @orrery/server gen",
    "db:generate": "pnpm --filter @orrery/server db:generate",
    "check": "oxfmt --check && oxlint --type-aware && pnpm -r typecheck",
    "fix": "oxfmt && oxlint --type-aware --fix",
    "test": "node --test scripts/*.test.mjs && pnpm --filter !@orrery/e2e -r test",
    "test:e2e": "pnpm --filter @orrery/e2e test"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.6",
    "lefthook": "^2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
